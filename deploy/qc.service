# systemd service: starts the quality inspection automatically at boot.
#   sudo cp deploy/qc.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now qc
[Unit]
Description=AI quality inspection of metal parts
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/pi_qc
# Optional: access protection for modifying actions (then open the page with ?token=...)
# Environment=QC_TOKEN=please-change
ExecStart=/home/pi/pi_qc/.venv/bin/python main.py --config config.json web --camera pi --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
